<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Package -->
        <PackageId>XlsCrypt.NativeExcelEncryption</PackageId>
        <Version>1.0.0</Version>
        <Authors>Sujit Tamang</Authors>
        <Description>Native .NET library for Excel workbook password encryption.</Description>
        <PackageTags>excel;xlsx;encryption;cryptography;office;security</PackageTags>

        <!-- License -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <!-- README -->
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md"
              Pack="true"
              PackagePath="\" />

        <None Include="..\..\LICENSE"
              Pack="true"
              PackagePath="\" />
    </ItemGroup>

</Project>